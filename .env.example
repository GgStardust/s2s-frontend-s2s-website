# Canonical site URL (used by Stripe success/cancel redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (Authors Edition direct checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: override direct-sale USD price (defaults to 44)
# DIRECT_SALE_PRICE_USD=44

# Optional transactional email for paid orders
# RESEND_API_KEY=
# FROM_EMAIL=
# ORDER_NOTIFICATION_EMAIL=gigi@gigistardust.com

# Optional contact form endpoint (Formspree / Getform).
# Used only by legacy contact JS.
# NEXT_PUBLIC_CONTACT_FORM_ACTION=

# Optional newsletter signup endpoint (Formspree).
# Used only by legacy newsletter integrations.
# NEXT_PUBLIC_NEWSLETTER_FORM_ACTION=https://formspree.io/f/xgvgzgaj
