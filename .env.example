# Canonical site URL (used by Stripe success/cancel redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (Authors Edition direct checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: override direct-sale USD price (defaults to 44)
# DIRECT_SALE_PRICE_USD=44

# Contact form endpoint (Formspree/Getform). Email stays configured on the provider.
NEXT_PUBLIC_CONTACT_FORM_ACTION=

# Optional transactional email for paid orders
# RESEND_API_KEY=
# ORDER_NOTIFY_EMAIL=
