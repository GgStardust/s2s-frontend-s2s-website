/**
 * Computation Layer - Resonance Engine
 * 
 * Analyzes content and extracts resonance information.
 * Transforms content into resonance vectors and category associations.
 * 
 * Architecture Layer: 2 (Computation)
 */

export interface EnergeticSignature {
  clarity: number;
  coherence: number;
  resonance: number;
  sovereignty: number;
}

export interface ResonanceAnalysis {
  overall_score: number;
  signature: EnergeticSignature;
  orb_associations: number[];
}

export class ResonanceEngine {
  private static instance: ResonanceEngine;

  private constructor() {}

  public static getInstance(): ResonanceEngine {
    if (!ResonanceEngine.instance) {
      ResonanceEngine.instance = new ResonanceEngine();
    }
    return ResonanceEngine.instance;
  }

  /**
   * Analyze content and extract resonance information
   */
  public async analyzeContent(content: string, title?: string): Promise<ResonanceAnalysis> {
    const signature = this.extractSignature(content, title);
    const orbAssociations = this.extractOrbAssociations(content);
    const overallScore = this.calculateOverallScore(signature, orbAssociations);
    
    return {
      overall_score: overallScore,
      signature,
      orb_associations: orbAssociations
    };
  }

  /**
   * Extract signature from content
   */
  private extractSignature(content: string, title?: string): EnergeticSignature {
    const text = (title ? title + ' ' : '') + content;
    const words = text.toLowerCase().split(/\s+/);
    
    const clarity = this.calculateClarity(text);
    const coherence = this.calculateCoherence(text);
    const resonance = this.calculateResonance(text);
    const sovereignty = this.calculateSovereignty(text);
    
    return {
      clarity: Math.max(0, Math.min(1, clarity)),
      coherence: Math.max(0, Math.min(1, coherence)),
      resonance: Math.max(0, Math.min(1, resonance)),
      sovereignty: Math.max(0, Math.min(1, sovereignty))
    };
  }

  /**
   * Extract category associations from content
   */
  private extractOrbAssociations(content: string): number[] {
    const text = content.toLowerCase();
    const associations: number[] = [];
    
    const orbKeywords: Record<number, string[]> = {
      1: ['origin', 'source', 'beginning', 'foundation'],
      2: ['resonance', 'vibration', 'frequency', 'harmony'],
      3: ['light', 'photon', 'illumination', 'clarity'],
      4: ['architecture', 'structure', 'design', 'pattern'],
      5: ['temporal', 'time', 'sovereignty', 'authority'],
      6: ['memory', 'starline', 'ancestral', 'lineage'],
      7: ['alchemical', 'transformation', 'current', 'flow'],
      8: ['quantum', 'intuition', 'knowing', 'insight'],
      9: ['fluidity', 'adaptation', 'flexibility', 'change'],
      10: ['repatterning', 'ancestral', 'healing', 'transformation'],
      11: ['transparency', 'radiant', 'clarity', 'truth'],
      12: ['sovereign', 'field', 'power', 'authority'],
      13: ['bridging', 'connection', 'integration', 'unity']
    };
    
    for (const [orb, keywords] of Object.entries(orbKeywords)) {
      const matches = keywords.filter(keyword => text.includes(keyword));
      if (matches.length > 0) {
        associations.push(parseInt(orb));
      }
    }
    
    if (associations.length === 0) {
      associations.push(1);
    }
    
    return associations;
  }

  /**
   * Calculate overall resonance score
   */
  private calculateOverallScore(
    signature: EnergeticSignature,
    orbAssociations: number[]
  ): number {
    const signatureScore = (
      signature.clarity * 0.25 +
      signature.coherence * 0.25 +
      signature.resonance * 0.25 +
      signature.sovereignty * 0.25
    );
    
    const orbScore = Math.min(1, orbAssociations.length / 13);
    
    return (signatureScore * 0.7 + orbScore * 0.3);
  }

  /**
   * Calculate clarity score
   */
  private calculateClarity(text: string): number {
    const sentences = text.split(/[.!?]+/).filter(s => s.trim().length > 0);
    const avgSentenceLength = sentences.reduce((sum, s) => sum + s.split(/\s+/).length, 0) / sentences.length;
    
    const optimalLength = 17.5;
    const lengthScore = 1 - Math.abs(avgSentenceLength - optimalLength) / optimalLength;
    
    const words = text.toLowerCase().split(/\s+/);
    const simpleWords = words.filter(w => w.length <= 5).length;
    const simplicityScore = simpleWords / words.length;
    
    return (lengthScore * 0.6 + simplicityScore * 0.4);
  }

  /**
   * Calculate coherence score
   */
  private calculateCoherence(text: string): number {
    const sentences = text.split(/[.!?]+/).filter(s => s.trim().length > 0);
    if (sentences.length < 2) return 0.5;
    
    const connectingWords = ['and', 'but', 'or', 'because', 'therefore', 'however', 'thus', 'hence'];
    const connections = connectingWords.filter(word => text.toLowerCase().includes(word)).length;
    const connectionScore = Math.min(1, connections / sentences.length);
    
    const flowWords = ['first', 'second', 'then', 'next', 'finally', 'consequently'];
    const flow = flowWords.filter(word => text.toLowerCase().includes(word)).length;
    const flowScore = Math.min(1, flow / sentences.length);
    
    return (connectionScore * 0.6 + flowScore * 0.4);
  }

  /**
   * Calculate resonance score
   */
  private calculateResonance(text: string): number {
    const words = text.toLowerCase().split(/\s+/);
    
    const resonantWords = [
      'love', 'harmony', 'peace', 'joy', 'beauty', 'truth', 'wisdom',
      'connection', 'unity', 'flow', 'energy', 'vibration', 'frequency'
    ];
    
    const matches = words.filter(w => resonantWords.includes(w)).length;
    const resonanceScore = Math.min(1, matches / Math.max(1, words.length / 10));
    
    return resonanceScore;
  }

  /**
   * Calculate sovereignty score
   */
  private calculateSovereignty(text: string): number {
    const words = text.toLowerCase().split(/\s+/);
    
    const sovereignWords = [
      'will', 'shall', 'must', 'authority', 'power', 'sovereign',
      'command', 'direct', 'decisive', 'certain', 'definite'
    ];
    
    const matches = words.filter(w => sovereignWords.includes(w)).length;
    const sovereigntyScore = Math.min(1, matches / Math.max(1, words.length / 10));
    
    return sovereigntyScore;
  }
}

