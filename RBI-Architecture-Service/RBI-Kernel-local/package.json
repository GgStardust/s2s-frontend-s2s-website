{
  "name": "rbi-kernel",
  "version": "1.0.0",
  "description": "RBI Kernel - Field-Level Coherence Architecture for resonance scoring and vector similarity",
  "type": "module",
  "main": "dist/kernel.js",
  "types": "dist/kernel.d.ts",
  "exports": {
    ".": {
      "import": "./dist/kernel.js",
      "types": "./dist/kernel.d.ts"
    },
    "./mathematics": {
      "import": "./dist/mathematics/index.js",
      "types": "./dist/mathematics/index.d.ts"
    },
    "./field": {
      "import": "./dist/field/computation/index.js",
      "types": "./dist/field/computation/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "rbi",
    "resonance",
    "vector-similarity",
    "coherence-architecture",
    "kernel",
    "api"
  ],
  "author": "Gigi Stardust / Stardust to Sovereignty UNA",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/GgStardust/rbi-kernel.git"
  },
  "dependencies": {
    "fastify": "^4.24.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}




